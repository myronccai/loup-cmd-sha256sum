@mode(host.dual)

# Application identity and exit statuses of sha256sum. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants compiled into the native binary
# build/sha256sum by `make build`; `loup run source/main.loup` and the unit
# tests (`make test`, Stage0) use the same definitions.

pub const APP_NAME: string = "sha256sum";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Print or check SHA-256 checksums (a Loup recreation of GNU sha256sum).";

# Exit statuses returned by main(), as GNU sha256sum uses them: any
# problem, including a usage error, gives 1.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
