@mode(host.dual)

# The command-line driver of sha256sum: parses argv, answers --help and
# --version, hashes or checks the files and returns the exit status (1 for
# any problem, usage errors included, as in GNU).
#
# Runtime: host.dual. Compiled into the native binary build/sha256sum by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/app_test.loup calls run() directly under Stage0 (`make test`).

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.sha256sum import (run_sha256sum);

# Parses argv, runs sha256sum and returns the exit status (0, or 1 for any
# problem including usage errors).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_FAILURE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_sha256sum(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
