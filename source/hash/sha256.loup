@mode(host.dual)

# SHA-256 (FIPS 180-4) in pure Loup.
#
# The algorithm works on 32-bit words with wrap-around addition. Loup's
# sized integers (`uint32`) throw NumericOverflowError when they overflow,
# so the words live in 64-bit `int`s and every sum is masked back to 32
# bits with `& MASK`. Rotations are built from two shifts and a mask.
#
# Runtime: host.dual. Compiled into the native binary build/sha256sum by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/sha256_test.loup checks it against the NIST vectors under Stage0
# (`make test`). Interpreted hashing is slow, so the one-million-'a' vector
# runs only against the binary, in the e2e tests.
#
# Structure: the constants (round_constants, initial_state), rotr, the
# compression function for one 64-byte block, padded_tail for the end of
# the message, and digest(), which feeds the whole blocks straight from the
# input and then the one or two padded blocks, before to_hex and
# hex_digest format the result.

const MASK: int = 0xFFFFFFFF;

# The first 32 bits of the fractional parts of the cube roots of the first
# 64 primes.
pub func round_constants(): list[int] {
    return [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
}

# The first 32 bits of the fractional parts of the square roots of the
# first 8 primes.
pub func initial_state(): list[int] {
    return [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
}

# Rotates the 32-bit word `x` right by `n` bits.
pub func rotr(x: int, n: int): int {
    return ((x >> n) | (x << (32 - n))) & MASK;
}

# Runs the compression function on one 64-byte block whose 16 big-endian
# words are already in w[0..16], updating the hash state `h`.
pub func compress(edits h: list[int], edits w: list[int], k: list[int]): void {
    # Message schedule: extend the 16 words to 64.
    for (t in 16..64) {
        let w15 = w[t - 15];
        let w2 = w[t - 2];
        let s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3);
        let s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10);
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK;
    }

    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];
    for (t in 0..64) {
        let big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let ch = (e & f) ^ ((e ^ MASK) & g);
        let t1 = (hh + big_s1 + ch + k[t] + w[t]) & MASK;
        let big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = (big_s0 + maj) & MASK;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & MASK;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & MASK;
    }
    h[0] = (h[0] + a) & MASK;
    h[1] = (h[1] + b) & MASK;
    h[2] = (h[2] + c) & MASK;
    h[3] = (h[3] + d) & MASK;
    h[4] = (h[4] + e) & MASK;
    h[5] = (h[5] + f) & MASK;
    h[6] = (h[6] + g) & MASK;
    h[7] = (h[7] + hh) & MASK;
}

# The padded tail of a message of `size` bytes whose last `size % 64` bytes
# start at `start` in `data`: those bytes, 0x80, zeros, and the length in
# bits as a 64-bit big-endian number, filling one or two blocks.
pub func padded_tail(data: bytes, start: int, size: int): list[int] {
    var tail: list[int] = [];
    for (i in start..size) {
        tail.push(data[i]);
    }
    tail.push(0x80);
    while (tail.len() % 64 != 56) {
        tail.push(0);
    }
    let bits = size * 8;
    var shift = 56;
    while (shift >= 0) {
        tail.push((bits >> shift) & 0xFF);
        shift -= 8;
    }
    return tail;
}

# The 32-byte SHA-256 digest of `data`.
pub func digest(data: bytes): list[int] {
    let k = round_constants();
    var h = initial_state();
    var w: list[int] = [];
    for (t in 0..64) {
        w.push(0);
    }

    # Whole blocks straight from the input.
    let size = data.len();
    let whole = size - size % 64;
    var base = 0;
    while (base < whole) {
        for (t in 0..16) {
            let i = base + t * 4;
            w[t] = (data[i] << 24) | (data[i + 1] << 16) | (data[i + 2] << 8) | data[i + 3];
        }
        compress(edits: h, edits: w, k);
        base += 64;
    }

    # The last partial block, the padding and the length.
    let tail = padded_tail(data, whole, size);
    base = 0;
    while (base < tail.len()) {
        for (t in 0..16) {
            let i = base + t * 4;
            w[t] = (tail[i] << 24) | (tail[i + 1] << 16) | (tail[i + 2] << 8) | tail[i + 3];
        }
        compress(edits: h, edits: w, k);
        base += 64;
    }

    var out: list[int] = [];
    for (word in h) {
        out.push((word >> 24) & 0xFF);
        out.push((word >> 16) & 0xFF);
        out.push((word >> 8) & 0xFF);
        out.push(word & 0xFF);
    }
    return out;
}

# Bytes as lower-case hex.
pub func to_hex(raw: list[int]): string {
    let digits = "0123456789abcdef";
    var parts: list[string] = [];
    for (b in raw) {
        parts.push(digits.slice(b >> 4, (b >> 4) + 1));
        parts.push(digits.slice(b & 15, (b & 15) + 1));
    }
    return parts.join("");
}

# The digest of `data` as 64 lower-case hex digits.
pub func hex_digest(data: bytes): string {
    return to_hex(digest(data));
}
