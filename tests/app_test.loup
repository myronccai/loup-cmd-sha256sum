@mode(host.dual)

# Tests for sha256sum's exit statuses, through cli.app.run with whole
# command lines. These tests print the program's normal output and error
# messages, and read tests/fixtures/, so run them from the repository root.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test --no-parallel`, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);
from cli.usage import (version_line);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
    expectEq(version_line(), "sha256sum (loup-cmd-sha256sum) 0.1.0", "version line");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_hash_succeeds(): void {
    expectEq(run(["tests/fixtures/abc.txt"]), EXIT_OK, "one file");
}

func test_missing_file_fails(): void {
    expectEq(run(["tests/fixtures/missing.txt"]), EXIT_FAILURE, "missing file");
}

func test_check_statuses(): void {
    expectEq(run(["-c", "tests/fixtures/good.sha256"]), EXIT_OK, "all OK");
    expectEq(run(["-c", "tests/fixtures/mixed.sha256"]), EXIT_FAILURE, "mismatch");
}

func test_usage_error_is_status_1(): void {
    expectEq(run(["--bogus"]), EXIT_FAILURE, "unknown option");
    expectEq(run(["--quiet", "x"]), EXIT_FAILURE, "--quiet without -c");
}
