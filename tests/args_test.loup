@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, resolve_long);

func test_no_arguments_reads_stdin(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.files.len(), 1, "one operand");
    expectEq(opts.files[0], "-", "standard input");
    expect(!opts.check and !opts.tag and !opts.zero, "no flags");
    expectEq(opts.binary, -1, "mode not given");
}

func test_operands_and_options_mix(): void {
    let opts = parse_args(["a", "-b", "b", "--tag", "c"]).unwrap();
    expectEq(opts.files.len(), 3, "three operands");
    expectEq(opts.files[2], "c", "order kept");
    expectEq(opts.binary, 1, "-b");
    expect(opts.tag, "--tag");
}

func test_combined_short_options(): void {
    let opts = parse_args(["-cw", "list"]).unwrap();
    expect(opts.check and opts.warn, "-cw");
    expect(parse_args(["-z"]).unwrap().zero, "-z");
    expectEq(parse_args(["-bt"]).unwrap().binary, 0, "last of -b/-t wins");
}

func test_long_option_prefixes(): void {
    expect(parse_args(["--che", "--stat", "x"]).unwrap().status, "--stat is --status");
    expectEq(resolve_long("ign", "--ign").unwrap(), "ignore-missing", "unique prefix");
    expectEq(resolve_long("tag", "--tag").unwrap(), "tag", "exact");
    expectEq(resolve_long("st", "--st").unwrap_err(), "option '--st' is ambiguous; possibilities: '--status' '--strict'", "ambiguous");
    expectEq(resolve_long("nope", "--nope").unwrap_err(), "unrecognized option '--nope'", "unknown");
}

func test_status_warn_quiet_replace_each_other(): void {
    let a = parse_args(["-c", "--status", "--warn"]).unwrap();
    expect(a.warn and !a.status, "--warn after --status");
    let b = parse_args(["-c", "--warn", "--quiet"]).unwrap();
    expect(b.quiet and !b.warn, "--quiet after --warn");
}

func test_double_dash_and_lone_dash(): void {
    let opts = parse_args(["--", "-c", "-"]).unwrap();
    expect(!opts.check, "-c after -- is a file");
    expectEq(opts.files[0], "-c", "operand");
    expectEq(opts.files[1], "-", "lone dash");
}

func test_help_and_version(): void {
    expect(parse_args(["x", "--help", "--bogus"]).unwrap().help, "--help stops parsing");
    expect(parse_args(["--vers"]).unwrap().version, "--vers");
}

func test_usage_errors(): void {
    expectEq(parse_args(["-x"]).unwrap_err(), "invalid option -- 'x'", "short");
    expectEq(parse_args(["--bogus"]).unwrap_err(), "unrecognized option '--bogus'", "long");
    expectEq(parse_args(["--tag=1"]).unwrap_err(), "option '--tag' doesn't allow an argument", "argument");
}

func test_invalid_combinations(): void {
    expectEq(parse_args(["--tag", "-t"]).unwrap_err(), "--tag does not support --text mode", "--tag --text");
    expectEq(parse_args(["-c", "-z"]).unwrap_err(), "the --zero option is not supported when verifying checksums", "-c -z");
    expectEq(parse_args(["-c", "--tag"]).unwrap_err(), "the --tag option is meaningless when verifying checksums", "-c --tag");
    expectEq(parse_args(["-c", "-b"]).unwrap_err(), "the --binary and --text options are meaningless when verifying checksums", "-c -b");
    expectEq(parse_args(["--quiet"]).unwrap_err(), "the --quiet option is meaningful only when verifying checksums", "--quiet");
    expectEq(parse_args(["--ignore-missing"]).unwrap_err(), "the --ignore-missing option is meaningful only when verifying checksums", "--ignore-missing");
}
